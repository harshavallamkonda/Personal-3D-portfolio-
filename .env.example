# API Keys for Portfolio Features

# Email Service (SendGrid, Postmark, or SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_USERNAME=your_sendgrid_username
SENDGRID_PASSWORD=your_sendgrid_password
FROM_EMAIL=your_from_email@domain.com
TO_EMAIL=your_to_email@domain.com

# Alternative: SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Geolocation Service
ABSTRACT_API_KEY=your_abstract_api_key_here
# Alternative: IPinfo (free tier available)
IPINFO_TOKEN=your_ipinfo_token_here

# Weather Service
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Analytics (Optional)
PLAUSIBLE_DOMAIN=your_domain.com
# Alternative: Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Deployment
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_ACCESS_TOKEN=your_netlify_access_token

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Performance Monitoring
LIGHTHOUSE_CI_TOKEN=your_lighthouse_ci_token
PAGESPEED_API_KEY=your_pagespeed_api_key

# CDN and Hosting
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# Database (Optional - for storing contact form submissions)
DATABASE_URL=your_database_connection_string
# Alternative: Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# File Storage (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name

# Monitoring and Logging
SENTRY_DSN=your_sentry_dsn
LOG_LEVEL=info

# Development
NODE_ENV=development
PORT=3000
DEBUG=portfolio:*